    {
      "name": "5. Filter by Price Range & Sort (Ascending)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "",
              "pm.test(\"All products fall within price range 1000 - 5000\", function () {",
              "    jsonData.products.forEach(function (product) {",
              "        pm.expect(product.price).to.be.at.least(1000);",
              "        pm.expect(product.price).to.be.at.most(5000);",
              "    });",
              "});",
              "",
              "pm.test(\"Products are sorted by price ascending\", function () {",
              "    for (var i = 0; i < jsonData.products.length - 1; i++) {",
              "        pm.expect(jsonData.products[i].price).to.be.at.most(jsonData.products[i + 1].price);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
