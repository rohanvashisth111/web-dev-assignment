    {
      "name": "2. Get All Products (Pagination & Defaults)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "",
              "pm.test(\"Response has pagination metadata structure\", function () {",
              "    pm.expect(jsonData).to.have.property(\"total\");",
              "    pm.expect(jsonData).to.have.property(\"page\");",
              "    pm.expect(jsonData).to.have.property(\"totalPages\");",
              "    pm.expect(jsonData).to.have.property(\"count\");",
              "    pm.expect(jsonData).to.have.property(\"products\");",
              "    pm.expect(jsonData.products).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Products include calculated stockValue\", function () {",
              "    if (jsonData.products.length > 0) {",
              "        var p = jsonData.products[0];",
              "        pm.expect(p).to.have.property(\"stockValue\");",
              "        pm.expect(p.stockValue).to.eql(p.price * p.quantity);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
