    {
      "name": "1. Create Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "",
              "pm.test(\"Response contains product fields\", function () {",
              "    pm.expect(jsonData).to.have.property(\"_id\");",
              "    pm.expect(jsonData.name).to.eql(\"Gel Pen Pack of 15 (Postman Test)\");",
              "    pm.expect(jsonData.sku).to.eql(\"STNY-PN-POSTMAN-01\");",
              "    pm.expect(jsonData.category).to.eql(\"Stationery\");",
              "    pm.expect(jsonData.price).to.eql(120);",
              "    pm.expect(jsonData.quantity).to.eql(40);",
              "    pm.expect(jsonData.reorderLevel).to.eql(20);",
              "    pm.expect(jsonData.supplier).to.eql(\"Cello Pens\");",
              "});",
              "",
              "pm.test(\"Calculated stockValue is price * quantity\", function () {",
              "    pm.expect(jsonData.stockValue).to.eql(4800);",
              "});",
              "",
              "// Save productId for downstream requests",
              "var id = jsonData._id || jsonData.id;",
              "pm.collectionVariables.set(\"productId\", id);",
              "console.log(\"Saved productId to collection variable:\", id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gel Pen Pack of 15 (Postman Test)\",\n  \"sku\": \"STNY-PN-POSTMAN-01\",\n  \"category\": \"Stationery\",\n  \"price\": 120,\n  \"quantity\": 40,\n  \"reorderLevel\": 20,\n  \"supplier\": \"Cello Pens\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Creates a new product in the inventory. Calculates stockValue dynamically and stores the returned _id in the {{productId}} collection variable."
      },
      "response": []
